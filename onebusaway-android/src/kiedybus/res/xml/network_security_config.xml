<?xml version="1.0" encoding="utf-8"?>
<!-- KiedyBus override of src/main/res/xml/network_security_config.xml: keep main's entries in sync. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
    <!-- KiedyBus's servers (*.iplaner.pl) chain to Certum Trusted Root CA, which isn't in the system
         trust store on older Android releases. Trust it for these hosts only, alongside the system
         store; HTTPS stays mandatory. Network security config is only read from API 24, so this
         does nothing on Android 6.0 (API 23). -->
    <domain-config>
        <domain includeSubdomains="true">iplaner.pl</domain>
        <trust-anchors>
            <certificates src="@raw/certum_root_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
